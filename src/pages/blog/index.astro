---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' }).toLowerCase();
---

<BaseLayout title="writing — elizabeth c." description="notes and essays.">
  <div class="reader">
    <a class="back-link" href="/">&#8592; home</a>

    <h1>writing</h1>

    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="card" href={`/blog/${post.id}/`}>
                <div class="text">
                  <div class="title">{post.data.title}</div>
                  {post.data.description && <div class="sub">{post.data.description}</div>}
                </div>
                <div class="date">{fmt(post.data.date)}</div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="sub">nothing published yet — check back soon.</p>
      )
    }
  </div>
</BaseLayout>
