---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toLowerCase();
---

<BaseLayout title="reading & writing — elizabeth cay" description="notes, essays, and things worth remembering.">
  <a class="back-link" href="/">&#8592; home</a>

  <h1>reading &amp; writing</h1>
  <p class="intro">notes, essays, and a running list of things worth remembering.</p>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-title">{post.data.title}</span>
              <span class="post-date"> · {fmt(post.data.date)}</span>
              {post.data.description && <div class="post-desc">{post.data.description}</div>}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="intro">nothing published yet — check back soon.</p>
    )
  }

  <Footer />
</BaseLayout>
