---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, work, school, projects, reading, writing, type Card } from '../data/profile';

const { github, linkedin, email } = profile.links;

const sections: { heading: string; items: Card[] }[] = [
  { heading: 'work', items: work },
  { heading: 'school', items: school },
  { heading: 'projects', items: projects },
  { heading: 'reading', items: reading },
  { heading: 'writing', items: writing },
];
---

<BaseLayout title={profile.name}>
  <div class="page">
    <aside class="intro">
      <h1 aria-label="hey, i'm elizabeth.">
        <span aria-hidden="true"><span id="greet">{profile.greetings[0]}</span><span class="caret"></span>, i'm elizabeth.</span>
      </h1>
      <p class="bio">{profile.bio}</p>

      <p class="find">find me here:</p>
      <ul class="links">
        <li><a href={github} target="_blank" rel="noopener">github</a></li>
        <li><a href={linkedin} target="_blank" rel="noopener">linkedin</a></li>
        <li><a href={`mailto:${email}`}>email</a></li>
      </ul>
    </aside>

    <main>
      {
        sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <div class="stack">
              {section.items.map((item) => (
                <a
                  class="card"
                  href={item.href ?? '#'}
                  {...(item.href?.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {item.logo && (
                    <div class="logo"><img src={item.logo} alt={`${item.sub ?? item.title} logo`} /></div>
                  )}
                  <div class="text">
                    <div class="title">{item.title}</div>
                    {item.sub && <div class="sub">{item.sub}</div>}
                  </div>
                  {item.date && <div class="date">{item.date}</div>}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </main>
  </div>

  <script is:inline data-greetings={JSON.stringify(profile.greetings)}>
    (() => {
      const el = document.getElementById('greet');
      const caret = document.querySelector('.caret');
      if (!el || !caret) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const words = JSON.parse(document.currentScript.dataset.greetings);
      const TYPE = 110, DELETE = 60, HOLD = 1800, GAP = 350;
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      let i = 0;

      async function loop() {
        while (true) {
          await sleep(HOLD);
          caret.classList.add('typing');
          let chars = Array.from(words[i]);
          while (chars.length) {
            chars.pop();
            el.textContent = chars.join('');
            await sleep(DELETE);
          }
          caret.classList.remove('typing');
          await sleep(GAP);
          caret.classList.add('typing');
          i = (i + 1) % words.length;
          const next = Array.from(words[i]);
          for (let n = 1; n <= next.length; n++) {
            el.textContent = next.slice(0, n).join('');
            await sleep(/[一-鿿]/.test(words[i]) ? TYPE * 2 : TYPE);
          }
          caret.classList.remove('typing');
        }
      }
      loop();
    })();
  </script>
</BaseLayout>
