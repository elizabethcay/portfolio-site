---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'elizabeth c. — engineering physics at mcmaster.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
